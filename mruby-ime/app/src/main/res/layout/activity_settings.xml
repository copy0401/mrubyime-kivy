<?xml version="1.0" encoding="utf-8"?>
<!--
  Settings surface. Structure: header → one card per section → footer.
  Every text/plate is re-coloured by MrubyimeSettingsActivity.applyTheme();
  any new view added here must be added to one of those lists, otherwise it
  keeps its XML colour and disappears in the opposite theme (white on white).
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/settings_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#000000">

    <LinearLayout
        android:id="@+id/settings_root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="26dp"
        android:paddingBottom="36dp">

        <!-- ============================ Header ============================ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/settings_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="小蝦米輸入法"
                    android:textSize="25sp"
                    android:textStyle="bold"
                    android:textColor="#FFD60A" />
            </LinearLayout>
        </LinearLayout>

        <!-- ========================= Card: 系統設定 ======================== -->
        <LinearLayout
            android:id="@+id/card_system"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="6dp">

                <TextView
                    android:id="@+id/sec_system_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="系統設定"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#FFD60A" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_system_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="首次使用請先啟用，再切換為小蝦米輸入法"
                android:textSize="12sp"
                android:textColor="#8E8E93" />

            <Button
                android:id="@+id/btn_enable_ime"
                android:layout_width="wrap_content"
                android:minWidth="112dp"
                android:layout_height="48dp"
                android:layout_marginBottom="8dp"
                android:layout_gravity="center_horizontal"
                android:gravity="start|center_vertical"
                android:text="1. 啟用輸入法設定"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#000000" />

            <Button
                android:id="@+id/btn_select_ime"
                android:layout_width="wrap_content"
                android:minWidth="112dp"
                android:layout_height="48dp"
                android:layout_gravity="center_horizontal"
                android:gravity="start|center_vertical"
                android:text="2. 切換 / 選擇輸入法"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#000000" />
        </LinearLayout>

        <!-- ================= 即時打字測試（只有輸入框，無標題） ============= -->
        <LinearLayout
            android:id="@+id/card_test"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical">

            <EditText
                android:id="@+id/et_test_input"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="在此點擊以測試輸入法…"
                android:inputType="text"
                android:autofillHints="text"
                android:textColor="#FFFFFF"
                android:textColorHint="#8E8E93"
                android:textSize="16sp"
                android:background="#1C1C1E"
                android:paddingStart="16dp"
                android:paddingEnd="16dp" />
        </LinearLayout>

        <!-- ======================= Card: 外觀與模式 ======================== -->
        <LinearLayout
            android:id="@+id/card_display"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">

                <TextView
                    android:id="@+id/sec_display_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="外觀與模式"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#FFD60A" />
            </LinearLayout>

            <CheckBox
                android:id="@+id/cb_hide_keyboard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:buttonTint="#FFD60A"
                android:text="隱藏虛擬鍵盤（僅保留候選列）"
                android:textColor="#FFFFFF"
                android:textSize="15sp" />

            <CheckBox
                android:id="@+id/cb_auto_commit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:buttonTint="#FFD60A"
                android:text="滿4碼且唯一候選自動上屏"
                android:textColor="#FFFFFF"
                android:textSize="15sp" />

            <CheckBox
                android:id="@+id/cb_clear_dead_code"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:buttonTint="#FFD60A"
                android:text="死碼清空編碼區（按鍵後確定無候選時自動清空）"
                android:textColor="#FFFFFF"
                android:textSize="15sp" />

            <CheckBox
                android:id="@+id/cb_max_code_clear"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:buttonTint="#FFD60A"
                android:text="最大碼清空組字（開啟時達 5 碼無候選清空；關閉可打長碼超過 6 碼僅顯示最後 6 碼）"
                android:textColor="#FFFFFF"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- ===================== Card: 輸入框內聯顯示 ====================== -->
        <LinearLayout
            android:id="@+id/card_inline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="6dp">

                <TextView
                    android:id="@+id/sec_inline_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="輸入框內聯顯示"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#FFD60A" />
            </LinearLayout>

            <RadioGroup
                android:id="@+id/rg_inline_mode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/rb_inline_off"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:buttonTint="#FFD60A"
                    android:text="不顯示"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp" />

                <RadioButton
                    android:id="@+id/rb_inline_code"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:buttonTint="#FFD60A"
                    android:text="輸入碼 (例如: aad)"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp" />

                <RadioButton
                    android:id="@+id/rb_inline_candidate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:buttonTint="#FFD60A"
                    android:text="選中的候選字 (例如: 微)"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp" />

                <RadioButton
                    android:id="@+id/rb_inline_candidate_code"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:buttonTint="#FFD60A"
                    android:text="選中候選字 ＋ 編碼 (例如: 微 aad)"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp" />

                <RadioButton
                    android:id="@+id/rb_inline_code_upper"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:buttonTint="#FFD60A"
                    android:text="大寫輸入碼 (例如: AAD)"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp" />

                <RadioButton
                    android:id="@+id/rb_inline_candidate_code_upper"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:buttonTint="#FFD60A"
                    android:text="選中候選字 ＋ 大寫編碼 (例如: 微 AAD)"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp" />

                <RadioButton
                    android:id="@+id/rb_inline_code_fullwidth"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:buttonTint="#FFD60A"
                    android:text="全形大寫輸入碼 (例如: ＡＡＤ)"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp" />

                <RadioButton
                    android:id="@+id/rb_inline_candidate_code_fullwidth"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:buttonTint="#FFD60A"
                    android:text="選中候選字 ＋ 全形大寫輸入碼 (例如: 微 ＡＡＤ)"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp" />
            </RadioGroup>
        </LinearLayout>

        <!-- ===================== Card: 輸入法碼表 (.cin) ================= -->
        <LinearLayout
            android:id="@+id/card_dict"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">

                <TextView
                    android:id="@+id/sec_dict_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="輸入法碼表（.cin）"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#FFD60A" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_dict_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:textSize="12sp"
                android:textColor="#8E8E93" />

            <RadioGroup
                android:id="@+id/rg_dict_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="8dp" />

            <Button
                android:id="@+id/btn_dict_import"
                android:layout_width="wrap_content"
                android:minWidth="112dp"
                android:layout_height="44dp"
                android:layout_marginBottom="8dp"
                android:layout_gravity="center_horizontal"
                android:text="匯入 (.cin)"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#FFD60A" />

            <Button
                android:id="@+id/btn_dict_export"
                android:layout_width="wrap_content"
                android:minWidth="112dp"
                android:layout_height="44dp"
                android:layout_marginBottom="8dp"
                android:layout_gravity="center_horizontal"
                android:text="匯出"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#FFD60A" />

            <Button
                android:id="@+id/btn_dict_reset"
                android:layout_width="wrap_content"
                android:minWidth="112dp"
                android:layout_height="44dp"
                android:layout_gravity="center_horizontal"
                android:text="恢復內建碼表"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#FFD60A" />

            <TextView
                android:id="@+id/tv_dict_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textSize="13sp"
                android:textColor="#8E8E93" />
        </LinearLayout>

        <!-- ===================== Card: 鍵盤佈局 (ruby dsl) =============== -->
        <LinearLayout
            android:id="@+id/card_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">

                <TextView
                    android:id="@+id/sec_layout_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="鍵盤佈局（ruby dsl）"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#FFD60A" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_layout_path"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:textSize="12sp"
                android:textColor="#8E8E93" />

            <TextView
                android:id="@+id/tv_layout_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:textSize="13sp"
                android:textColor="#8E8E93" />

            <Button
                android:id="@+id/btn_layout_import"
                android:layout_width="wrap_content"
                android:minWidth="112dp"
                android:layout_height="44dp"
                android:layout_marginBottom="8dp"
                android:layout_gravity="center_horizontal"
                android:text="匯入 (.rb)"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#FFD60A" />

            <Button
                android:id="@+id/btn_layout_export"
                android:layout_width="wrap_content"
                android:minWidth="112dp"
                android:layout_height="44dp"
                android:layout_marginBottom="8dp"
                android:layout_gravity="center_horizontal"
                android:text="匯出"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#FFD60A" />

            <Button
                android:id="@+id/btn_layout_install_dir"
                android:layout_width="wrap_content"
                android:minWidth="112dp"
                android:layout_height="44dp"
                android:layout_marginBottom="8dp"
                android:layout_gravity="center_horizontal"
                android:text="寫入編輯目錄"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#FFD60A" />

            <Button
                android:id="@+id/btn_layout_reset"
                android:layout_width="wrap_content"
                android:minWidth="112dp"
                android:layout_height="44dp"
                android:layout_marginBottom="8dp"
                android:layout_gravity="center_horizontal"
                android:text="恢復內建佈局"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#FFD60A" />

            <Button
                android:id="@+id/btn_layout_open_editor"
                android:layout_width="wrap_content"
                android:minWidth="112dp"
                android:layout_height="44dp"
                android:layout_gravity="center_horizontal"
                android:text="用外部編輯器開啟"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#FFD60A" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
