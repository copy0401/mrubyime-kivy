# Gradle / Android build output
mruby-ime/.gradle/
mruby-ime/build/
mruby-ime/app/build/
mruby-ime/app/.cxx/
mruby-ime/.kotlin/
mruby-ime/local.properties

# mruby: the source tree is vendored (MIT); the compiled artifacts are not.
# libmruby.a is regenerated by mruby-ime/build_mruby.sh and must stay on disk
# for CMake to link, but it is not a tracked artifact.
mruby-ime/mruby/build/

# python-for-android / buildozer caches (~5.9 GB)
.buildozer/
mruby-ime/.buildozer/
mruby-ime/bin/

# Host virtualenv used only for desktop previews of the Kivy UI (~177 MB)
kivy-venv/

# Packaged artifacts
*.apk
*.aab
